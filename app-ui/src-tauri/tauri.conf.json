{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRemote",
  "version": "1.0.26",
  "identifier": "com.openremote.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenRemote - High Performance Remote Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "OpenRemote",
    "shortDescription": "High-Performance Cross-Platform Remote Desktop",
    "longDescription": "High-Performance Cross-Platform Remote Desktop client with ultra-low latency Direct LAN streaming, multi-monitor display switching, and hardware-accelerated screen capture.",
    "copyright": "Copyright (c) 2026 OpenRemote",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsi"
      },
      "wix": {
        "language": ["en-US"]
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": null,
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMzY2RThDNkM5OThBODkKUldTSmlwbHNqRzQycjJMY1NNYmNwMFNBakFOQThzSko3QmxabWk0MDFWUlNJZU1DbUpVNnRtZDEK",
      "endpoints": [
        "https://github.com/storyboxvasu-sudo/Open-Remote/releases/latest/download/latest.json"
      ],
      "timeout": 30000,
      "windows": {
        "installMode": "passive"
      }
    },
    "signaling": {
      "endpoint": "wss://open-remote.onrender.com"
    }
  }
}
